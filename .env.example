# FastighetsRadar – example environment (IMPLEMENTATION.md §6).
# Copy to `.env` for local development. NEVER commit real values.
# Only NEXT_PUBLIC_* variables reach the browser – never put secrets in them.

# === APP ===
NODE_ENV=development
APP_URL=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
TZ=Europe/Stockholm
LOG_LEVEL=info

# /overview and /properties always show LIVE customer data from the API (no fixture fallback).
# The approved design with labelled demo fixtures is served at /demo/* only when this is true.
# Keep false in production.
FASTIGHETSRADAR_DEMO_ENABLED=true
# Internal URL the Next.js server uses to reach Fastify (never public).
FASTIGHETSRADAR_INTERNAL_API_URL=http://127.0.0.1:4000

# === DATABASE / QUEUES (docker compose up -d) ===
# Local docker: password auth. On the f-radar pod the socket + peer auth form is used (no password):
#   postgresql:///fastighetsradar?host=/var/run/postgresql
DATABASE_URL=postgresql://fastighetsradar:local_dev_password@localhost:5432/fastighetsradar
REDIS_URL=redis://localhost:6379

# === AUTH: Clerk (decision 2026-11-12, docs/decisions/0002-auth-tenancy-deployment.md) ===
# Standard Clerk names (production instance clerk.f-radar.se – only works on that domain once DNS exists).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Development instance. When BOTH are set (pk_test_/sk_test_), they take precedence over the pair above.
NEXT_PUBLIC_CLERK_DEVELOPMENT_KEY=
CLERK_SECRET=
# Optional: PEM public key for networkless JWT verification in Fastify (Clerk Dashboard → API keys).
CLERK_JWT_KEY=
# Origins accepted as the session token `azp` claim (comma-separated). Defaults to APP_URL.
CLERK_AUTHORIZED_PARTIES=

# === GEOCODING & MAP ===
# Geoapify is the primary geocoder. Without a key, onboarding falls back to a manual map pin.
GEOCODING_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GEOAPIFY_AUTOCOMPLETE_URL=https://api.geoapify.com/v1/geocode/autocomplete
GEOAPIFY_GEOCODING_URL=https://api.geoapify.com/v1/geocode/search
GEOAPIFY_COUNTRY_FILTER=se
GEOAPIFY_LANGUAGE=sv
# --- Map tiles: Geoapify (decision 2026-11-13, see IMPLEMENTATION_PROGRESS.md) ---
# SEPARATE browser key, NOT GEOAPIFY_API_KEY. It is public (inlined into the JS bundle at build time),
# so restrict it in https://myprojects.geoapify.com → project → API keys → allowed origins/HTTP referrers:
#   https://f-radar.fr-2.instapods.app, http://localhost:3000 (later also https://app.f-radar.se).
# The build fails if this equals GEOAPIFY_API_KEY. Without it, maps render without tiles (no watermark).
NEXT_PUBLIC_GEOAPIFY_MAP_KEY=
# Light raster style: positron (default – matches the approved CARTO look), osm-bright-grey, osm-bright-smooth, osm-bright, klokantech-basic, toner-grey, osm-liberty
NEXT_PUBLIC_MAP_STYLE=positron
# Optional escape hatch for another raster provider (Leaflet URL template + HTML attribution). Overrides Geoapify.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# === VERIFIED PUBLIC SOURCE ENTRYPOINTS ===
SMHI_FORECAST_BASE_URL=https://opendata-download-metfcst.smhi.se/api
SMHI_WARNINGS_URL=https://opendata-download-warnings.smhi.se/ibww/api/version/1/warning.json
SMHI_OBSERVATIONS_BASE_URL=https://opendata-download-metobs.smhi.se/api
KRISINFORMATION_BASE_URL=https://api.krisinformation.se/v3
AIR_QUALITY_BASE_URL=https://datavardluft.smhi.se/52North/api/
SGU_OBSERVED_GROUNDWATER_BASE_URL=https://api.sgu.se/oppnadata/grundvattennivaer-observerade/ogc/features/v1
SGU_REGIONAL_GROUNDWATER_BASE_URL=https://api.sgu.se/oppnadata/grundvattennivaer-sgu-hype-omraden/ogc/features/v1
SCB_PXWEB_V2_BASE_URL=https://statistikdatabasen.scb.se

# MCF flood scenarios via the INSPIRE WFS (static scenarios, verified 2026-11-13)
MCF_FLOOD_ENABLED=true
MCF_GIS_DATASET_MANIFEST=

# === SOURCES THAT REQUIRE REGISTRATION / APPROVAL ===
# Register (private or company): https://data.trafikverket.se/oauth2/Account/register
# Phase 3: set TRAFIKVERKET_ENABLED=true when the key is present (deploy script does this automatically).
TRAFIKVERKET_ENABLED=false
TRAFIKVERKET_API_KEY=
LANTMATERIET_ENABLED=false
LANTMATERIET_AUTH_METHOD=
LANTMATERIET_CLIENT_ID=
LANTMATERIET_CLIENT_SECRET=
BOVERKET_ENABLED=false
BOVERKET_API_KEY=

# === SMS / 46ELKS ===
# Phase 4 always uses a local simulator, independent of SMS_ENABLED (the real-delivery switch).
# The 46elks adapter has an additional code-level live lock. Credentials alone never activate it.
SMS_ENABLED=false
SMS_PROVIDER=simulated
SMS_DRY_RUN=true
SMS_LIVE_SENDING_APPROVED=false
SMS_TEST_ALLOWLIST=
SMS_SENDER=FRadar
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
SMS_DAILY_LIMIT_PER_ORG=20
SMS_MONTHLY_LIMIT_PER_ORG=0
SMS_GLOBAL_DAILY_BUDGET_SEK=0
SMS_MAX_GLOBAL_MONTHLY_COST_SEK=0
# Local simulated messages have their own non-billable limit.
SMS_SIMULATION_MONTHLY_LIMIT=100
SMS_MAX_MESSAGES_PER_MINUTE=10
# Optional estimate only, SEK per part. Empty means unknown, never an assumed price.
SMS_ESTIMATED_PRICE_PER_PART_SEK=
# Future authenticated delivery callbacks (Basic Auth username elks), at least 32 random characters.
SMS_WEBHOOK_AUTH_SECRET=

# === SOURCE CONTROL FLAGS ===
# In-process collector scheduler (API process). Enable locally only when you want real fetches.
MONITORING_SCHEDULER_ENABLED=false
SOURCE_SMHI_FORECAST_ENABLED=true
SOURCE_SMHI_WARNINGS_ENABLED=true
SOURCE_SMHI_OBSERVATIONS_ENABLED=true
SOURCE_KRISINFORMATION_ENABLED=true
SOURCE_AIR_QUALITY_ENABLED=true
SOURCE_SGU_ENABLED=true
SOURCE_SCB_ENABLED=true

# === INFRASTRUCTURE (local tooling only – never deployed) ===
# InstaPods API token for scripts/instapods.mjs and scripts/deploy-pod.mjs (same name the official CLI uses).
INSTAPOD_TOKEN=

# Optional radar forecast, disabled until explicitly enabled locally.
SOURCE_MET_NOWCAST_ENABLED=false
# Must be a reachable public address (MET Norway terms). Switch to the own domain once it is live.
MET_NORWAY_CONTACT=https://github.com/Mulanger/F-Radar/issues
SOURCE_SMHI_OCEANOGRAPHY_ENABLED=false
SOURCE_SMHI_HYDROLOGY_ENABLED=false
# Station sources (empty flags use documented defaults; SL stays off).
SOURCE_SGU_OBSERVED_ENABLED=
SOURCE_SL_DEVIATIONS_ENABLED=
SL_DEVIATIONS_API_KEY=

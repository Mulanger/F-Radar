 ge utförarna av arbetet en god arbetsmiljö utan att det uppstår trafikolyckor.  Utryckningsfordon kommer att släppas fram.  Arbetet är beställt och planerat tillsammans med beställare.\n","MessageCode":"Vägarbete","MessageCodeValue":"roadworks","MessageType":"Vägarbete","MessageTypeValue":"MaintenanceWorks","RoadName":"Enskedevägen","RoadNumber":"Väg 75","RoadNumberNumeric":75,"SeverityCode":2,"SeverityText":"Liten påverkan","StartTime":"2025-01-16T11:33:00.000+01:00","LocationDescriptor":"Väg 75 på Södra Länken mellan Trafikplats Åbyvägen och Anslutning Värmdöleden, i båda riktningar.","VersionTime":"2025-05-15T14:47:04.987+02:00"}],"Id":"GUID80ecdf8d-dac5-4dee-b86a-e2e711b1e9d1","PublicationTime":"2025-06-10T10:05:24.001+02:00","VersionTime":"2025-05-15T14:47:04.987+02:00","ModifiedTime":"2025-06-10T08:05:24.093Z"},{"CountryCode":"SE","Deleted":false,"Deviation":[{"AffectedDirection":"Båda riktningarna","AffectedDirectionValue":"BothDirections","CountyNo":[2,1],"Creator":"Trafikverket","CreationTime":"2026-10-20T09:26:04.557+02:00","EndTime":"2026-12-30T16:00:00.000+01:00", "Geometry":{"SWEREF99TM":"POINT (673288 6576953)","WGS84":"POINT (18.04302879445 59.2958418938242)", "Point":{"SWEREF99TM":"POINT (673288 6576953)","WGS84":"POINT (18.04302879445 59.2958418938242)"}, "Line":{"SWEREF99TM":"LINESTRING (673274.6998515965 6577030.643255922, 673277.4798515938 6577022.723255934, 673285.4398515864 6576977.383256007, 673286.5798515854 6576969.08325602, 673287.9798515836 6576958.923256039, 673291.6398515799 6576932.303256082, 673293.2398515781 6576922.403256101, 673297.3098515745 6576904.64325613, 673323.9898515517 6576893.2232561475)","WGS84":"LINESTRING (18.04285783520556 59.29654358707442, 18.042900228017785 59.29647142449605, 18.043003449887955 59.29606157239136, 18.043016785012522 59.29598667432254, 18.04303318783881 59.295894990008144, 18.043076021966648 59.29565477319792, 18.043096139189228 59.29556533846111, 18.043153260609323 59.295404406189654, 18.04361185004